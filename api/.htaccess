Options -Indexes

# Rutas limpias: /api/validar_token → validar_token.php (igual que en el servidor antiguo)
RewriteEngine On
RewriteRule ^(validar_token|activar_licencia|comprobar|motor|recuperar|recuperar_confirmar|ping)$ $1.php [L]

# La configuración (contraseñas) y la librería interna no se pueden abrir desde fuera
<FilesMatch "^(config\.php|config\.ejemplo\.php|_lib\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
